# GitHub Actions / Vercel env reference.
# These are the env vars you need to configure in:
#   - Vercel project (Production / Preview / Development)
#   - GitHub repo secrets (for the Deploy workflow)
#
# Values go in:
#   - Vercel:    Project → Settings → Environment Variables
#   - GitHub:    Repo → Settings → Secrets and variables → Actions

# Database (Turso)
TURSO_URL=
TURSO_TOKEN=

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# After first deploy, set to the actual URL (e.g. https://odonto.vercel.app)
AUTH_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
# Dedicated PUBLIC store for the per-dentist calendar feeds (main store is private)
BLOB_CALENDAR_READ_WRITE_TOKEN=

# Cron authentication for /api/cron/mark-no-shows (generate with openssl rand -base64 32)
CRON_SECRET=

# Optional auto no-show grace period in minutes (default 60)
NO_SHOW_GRACE_MIN=60


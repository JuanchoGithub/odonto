# Database (Turso / LibSQL)
TURSO_URL=file:./local.db
TURSO_TOKEN=

# Auth.js
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Session lifetime (seconds). Defaults: 1 year sliding window, refreshed at
# most once per day of active use. Lower SESSION_MAX_AGE_SEC (e.g. 2592000
# for 30 days) on shared devices.
SESSION_MAX_AGE_SEC=31536000
SESSION_UPDATE_AGE_SEC=86400

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
# Dedicated PUBLIC store for the per-dentist calendar feeds (the main store
# above is private). Read/write token of the calendar store; falls back to
# BLOB_READ_WRITE_TOKEN when empty (which fails on a private store).
BLOB_CALENDAR_READ_WRITE_TOKEN=

# Seed config
CLINIC_LOCALE=es

# Cron (Vercel sets Authorization: Bearer <CRON_SECRET> for /api/cron/*).
# Leave empty locally to allow unauthenticated cron hits in dev.
CRON_SECRET=

# Minutes after an appointment ends before the auto no-show sweep flips it.
NO_SHOW_GRACE_MIN=60

